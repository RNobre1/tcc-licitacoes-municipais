# Secret key used for cryptographic signing sessions, CSRF tokens, password reset tokens, and cookies.
# REQUIRED in production. Never commit the actual production key.
SECRET_KEY=replace-with-a-secure-token

# Set True for local development to enable verbose logging. Defaults to False.
DEBUG=True

# Comma-separated list of hostnames/IPs this service respond to.
ALLOWED_HOSTS=127.0.0.1,localhost

# Secret key used for cryptographic signing sessions, CSRF tokens, password reset tokens, and cookies.
# REQUIRED in production. Never commit the actual production key.
SECRET_KEY=replace-with-a-secure-token

# Set True for local development to enable verbose logging. Defaults to False.
DEBUG=False

# Comma-separated list of hostnames/IPs this service responds to.
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL host address for database connections.
DATABASE_HOST=127.0.0.1

# PostgreSQL host port (5433 to avoid collision with local Homebrew PostgreSQL on 5432).
DATABASE_PORT=5433

# PostgreSQL database name for the preparatory phase service.
DATABASE_NAME=preparatory_phase

# PostgreSQL database username.
DATABASE_USER=preparatory_phase

# PostgreSQL database user password for local development. Never commit production credentials.
DATABASE_PASSWORD=replace-with-a-local-database-password

# Qdrant vector database HTTP API URL.
QDRANT_URL=http://127.0.0.1:6333

    {
      "name": "2. Armadilhas (rode para ver com seus olhos)",
      "item": [
        {
          "name": "ARMADILHA 1 — paginação silenciosa (só 10 itens, HTTP 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [

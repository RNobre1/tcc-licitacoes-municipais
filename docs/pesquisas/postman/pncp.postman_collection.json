            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_integra}}/v1/orgaos/{{cnpj}}/compras/{{ano}}/{{seq}}",
              "protocol": "https",
              "host": ["pncp", "gov", "br"],
              "path": ["api", "pncp", "v1", "orgaos", "{{cnpj}}", "compras", "{{ano}}", "{{seq}}"]
            },
            "description": "Metadados da contratação. Note que só há valores TOTAIS aqui — é por isso que a API de Consulta não resolve o problema."

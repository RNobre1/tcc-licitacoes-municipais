<?xml version="1.0" encoding="UTF-8"?>
<!--
  Processo da fase preparatória de uma contratação, modelado em BPMN 2.0.

  ESTE ARQUIVO É A FONTE. É XML padrão OMG, e abre em qualquer ferramenta BPMN
  2.0 — inclusive na que a orientação indicou, para conferência. A figura do
  texto é gerada dele por `scripts/gerar_bpmn.py`, e nunca o contrário.

  O recorte é o mesmo do diagrama de fluxo da arquitetura: contratação de
  material ou serviço comum, com valor estimado montado por pesquisa de preços.
  Obras ficam de fora, porque o orçamento delas sai de planilha de custos sobre
  tabela de referência, que é outro mecanismo.

  As duas decisões exclusivas representam etapas que podem não acontecer:
  consolidação só existe quando mais de uma secretaria pede o mesmo item, e a
  pesquisa de preços é pulada quando o preço vem de ata ou contrato vigente.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="defs_licitacao"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="colaboracao">
    <bpmn:participant id="pool_prefeitura" name="Prefeitura"
                      processRef="processo_licitacao" />
  </bpmn:collaboration>
  <bpmn:process id="processo_licitacao" isExecutable="false">
    <bpmn:laneSet id="raias">
      <bpmn:lane id="raia_secretaria" name="Secretaria demandante">
        <bpmn:flowNodeRef>ev_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_formalizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_alinhar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_licitacoes" name="Setor de licitações">
        <bpmn:flowNodeRef>t_importar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_consolida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_ata</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_triar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_fim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_sistema" name="Sistema de apoio">
        <bpmn:flowNodeRef>t_extrair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_consenso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_minuta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_recuperar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_calcular</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pecas</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ev_inicio" name="Necessidade identificada">
      <bpmn:outgoing>fl_ev_inicio_t_formalizar</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t_formalizar" name="Formalizar demanda">
      <bpmn:incoming>fl_ev_inicio_t_formalizar</bpmn:incoming>
      <bpmn:outgoing>fl_t_formalizar_t_importar</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_importar" name="Importar documentos de demanda">
      <bpmn:incoming>fl_t_formalizar_t_importar</bpmn:incoming>
      <bpmn:outgoing>fl_t_importar_t_extrair</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_extrair" name="Extrair itens, quantidades e unidades">
      <bpmn:incoming>fl_t_importar_t_extrair</bpmn:incoming>
      <bpmn:outgoing>fl_t_extrair_g_consolida</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_consolida" name="Mesmo item em outra secretaria?">
      <bpmn:incoming>fl_t_extrair_g_consolida</bpmn:incoming>
      <bpmn:outgoing>fl_g_consolida_t_consenso</bpmn:outgoing>
      <bpmn:outgoing>fl_g_consolida_t_minuta</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_consenso" name="Propor descrição de consenso">
      <bpmn:incoming>fl_g_consolida_t_consenso</bpmn:incoming>
      <bpmn:outgoing>fl_t_consenso_t_alinhar</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_alinhar" name="Alinhar com as secretarias">
      <bpmn:incoming>fl_t_consenso_t_alinhar</bpmn:incoming>
      <bpmn:outgoing>fl_t_alinhar_t_minuta</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_minuta" name="Emitir minuta do estudo técnico">
      <bpmn:incoming>fl_t_alinhar_t_minuta</bpmn:incoming>
      <bpmn:incoming>fl_g_consolida_t_minuta</bpmn:incoming>
      <bpmn:outgoing>fl_t_minuta_g_ata</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_ata" name="Preço vem de ata vigente?">
      <bpmn:incoming>fl_t_minuta_g_ata</bpmn:incoming>
      <bpmn:outgoing>fl_g_ata_t_recuperar</bpmn:outgoing>
      <bpmn:outgoing>fl_g_ata_t_pecas</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_recuperar" name="Recuperar candidatos por significado">
      <bpmn:incoming>fl_g_ata_t_recuperar</bpmn:incoming>
      <bpmn:outgoing>fl_t_recuperar_t_triar</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_triar" name="Triar candidatos e decidir">
      <bpmn:incoming>fl_t_recuperar_t_triar</bpmn:incoming>
      <bpmn:outgoing>fl_t_triar_t_calcular</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_calcular" name="Calcular valor e gerar mapa de cotação">
      <bpmn:incoming>fl_t_triar_t_calcular</bpmn:incoming>
      <bpmn:outgoing>fl_t_calcular_t_pecas</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_pecas" name="Gerar estudo final e termo de referência">
      <bpmn:incoming>fl_t_calcular_t_pecas</bpmn:incoming>
      <bpmn:incoming>fl_g_ata_t_pecas</bpmn:incoming>
      <bpmn:outgoing>fl_t_pecas_ev_fim</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="ev_fim" name="Processo instruído">
      <bpmn:incoming>fl_t_pecas_ev_fim</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="fl_ev_inicio_t_formalizar" sourceRef="ev_inicio" targetRef="t_formalizar" />
    <bpmn:sequenceFlow id="fl_t_formalizar_t_importar" sourceRef="t_formalizar" targetRef="t_importar" />
    <bpmn:sequenceFlow id="fl_t_importar_t_extrair" sourceRef="t_importar" targetRef="t_extrair" />
    <bpmn:sequenceFlow id="fl_t_extrair_g_consolida" sourceRef="t_extrair" targetRef="g_consolida" />
    <bpmn:sequenceFlow id="fl_g_consolida_t_consenso" name="sim" sourceRef="g_consolida" targetRef="t_consenso" />
    <bpmn:sequenceFlow id="fl_t_consenso_t_alinhar" sourceRef="t_consenso" targetRef="t_alinhar" />
    <bpmn:sequenceFlow id="fl_t_alinhar_t_minuta" sourceRef="t_alinhar" targetRef="t_minuta" />
    <bpmn:sequenceFlow id="fl_g_consolida_t_minuta" name="não" sourceRef="g_consolida" targetRef="t_minuta" />
    <bpmn:sequenceFlow id="fl_t_minuta_g_ata" sourceRef="t_minuta" targetRef="g_ata" />
    <bpmn:sequenceFlow id="fl_g_ata_t_recuperar" name="não" sourceRef="g_ata" targetRef="t_recuperar" />
    <bpmn:sequenceFlow id="fl_t_recuperar_t_triar" sourceRef="t_recuperar" targetRef="t_triar" />
    <bpmn:sequenceFlow id="fl_t_triar_t_calcular" sourceRef="t_triar" targetRef="t_calcular" />
    <bpmn:sequenceFlow id="fl_t_calcular_t_pecas" sourceRef="t_calcular" targetRef="t_pecas" />
    <bpmn:sequenceFlow id="fl_g_ata_t_pecas" name="sim" sourceRef="g_ata" targetRef="t_pecas" />
    <bpmn:sequenceFlow id="fl_t_pecas_ev_fim" sourceRef="t_pecas" targetRef="ev_fim" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagrama">
    <bpmndi:BPMNPlane id="plano" bpmnElement="colaboracao">
      <bpmndi:BPMNShape id="di_pool" bpmnElement="pool_prefeitura" isHorizontal="true">
        <dc:Bounds x="150" y="60" width="2000" height="560" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_raia_secretaria" bpmnElement="raia_secretaria" isHorizontal="true">
        <dc:Bounds x="180" y="60" width="1970" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_raia_licitacoes" bpmnElement="raia_licitacoes" isHorizontal="true">
        <dc:Bounds x="180" y="210" width="1970" height="210" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_raia_sistema" bpmnElement="raia_sistema" isHorizontal="true">
        <dc:Bounds x="180" y="420" width="1970" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_ev_inicio" bpmnElement="ev_inicio">
        <dc:Bounds x="200" y="117" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_t_formalizar" bpmnElement="t_formalizar">
        <dc:Bounds x="280" y="95" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_t_importar" bpmnElement="t_importar">
        <dc:Bounds x="450" y="275" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_t_extrair" bpmnElement="t_extrair">
        <dc:Bounds x="620" y="480" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_g_consolida" bpmnElement="g_consolida">
        <dc:Bounds x="800" y="290" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_t_consenso" bpmnElement="t_consenso">
        <dc:Bounds x="890" y="480" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_t_alinhar" bpmnElement="t_alinhar">
        <dc:Bounds x="890" y="95" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_t_minuta" bpmnElement="t_minuta">
        <dc:Bounds x="1060" y="480" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_g_ata" bpmnElement="g_ata">
        <dc:Bounds x="1240" y="290" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_t_recuperar" bpmnElement="t_recuperar">
        <dc:Bounds x="1330" y="480" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_t_triar" bpmnElement="t_triar">
        <dc:Bounds x="1500" y="275" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_t_calcular" bpmnElement="t_calcular">
        <dc:Bounds x="1670" y="480" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_t_pecas" bpmnElement="t_pecas">
        <dc:Bounds x="1840" y="480" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_ev_fim" bpmnElement="ev_fim">
        <dc:Bounds x="2030" y="297" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="di_fl_ev_inicio_t_formalizar" bpmnElement="fl_ev_inicio_t_formalizar">
        <di:waypoint x="236" y="135" />
        <di:waypoint x="280" y="135" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_fl_t_formalizar_t_importar" bpmnElement="fl_t_formalizar_t_importar">
        <di:waypoint x="400" y="135" />
        <di:waypoint x="425" y="135" />
        <di:waypoint x="425" y="315" />
        <di:waypoint x="450" y="315" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_fl_t_importar_t_extrair" bpmnElement="fl_t_importar_t_extrair">
        <di:waypoint x="570" y="315" />
        <di:waypoint x="595" y="315" />
        <di:waypoint x="595" y="520" />
        <di:waypoint x="620" y="520" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_fl_t_extrair_g_consolida" bpmnElement="fl_t_extrair_g_consolida">
        <di:waypoint x="740" y="520" />
        <di:waypoint x="770" y="520" />
        <di:waypoint x="770" y="315" />
        <di:waypoint x="800" y="315" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_fl_g_consolida_t_consenso" bpmnElement="fl_g_consolida_t_consenso">
        <di:waypoint x="850" y="315" />
        <di:waypoint x="870" y="315" />
        <di:waypoint x="870" y="520" />
        <di:waypoint x="890" y="520" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_fl_t_consenso_t_alinhar" bpmnElement="fl_t_consenso_t_alinhar">
        <di:waypoint x="1010" y="520" />
        <di:waypoint x="1040" y="520" />
        <di:waypoint x="1040" y="135" />
        <di:waypoint x="890" y="135" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_fl_t_alinhar_t_minuta" bpmnElement="fl_t_alinhar_t_minuta">
        <di:waypoint x="1010" y="135" />
        <di:waypoint x="1035" y="135" />
        <di:waypoint x="1035" y="520" />
        <di:waypoint x="1060" y="520" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_fl_g_consolida_t_minuta" bpmnElement="fl_g_consolida_t_minuta">
        <di:waypoint x="850" y="315" />
        <di:waypoint x="955" y="315" />
        <di:waypoint x="955" y="520" />
        <di:waypoint x="1060" y="520" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_fl_t_minuta_g_ata" bpmnElement="fl_t_minuta_g_ata">
        <di:waypoint x="1180" y="520" />
        <di:waypoint x="1210" y="520" />
        <di:waypoint x="1210" y="315" />
        <di:waypoint x="1240" y="315" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_fl_g_ata_t_recuperar" bpmnElement="fl_g_ata_t_recuperar">
        <di:waypoint x="1290" y="315" />
        <di:waypoint x="1310" y="315" />
        <di:waypoint x="1310" y="520" />
        <di:waypoint x="1330" y="520" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_fl_t_recuperar_t_triar" bpmnElement="fl_t_recuperar_t_triar">
        <di:waypoint x="1450" y="520" />
        <di:waypoint x="1475" y="520" />
        <di:waypoint x="1475" y="315" />
        <di:waypoint x="1500" y="315" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_fl_t_triar_t_calcular" bpmnElement="fl_t_triar_t_calcular">
        <di:waypoint x="1620" y="315" />
        <di:waypoint x="1645" y="315" />
        <di:waypoint x="1645" y="520" />
        <di:waypoint x="1670" y="520" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_fl_t_calcular_t_pecas" bpmnElement="fl_t_calcular_t_pecas">
        <di:waypoint x="1790" y="520" />
        <di:waypoint x="1840" y="520" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_fl_g_ata_t_pecas" bpmnElement="fl_g_ata_t_pecas">
        <di:waypoint x="1290" y="315" />
        <di:waypoint x="1565" y="315" />
        <di:waypoint x="1565" y="520" />
        <di:waypoint x="1840" y="520" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_fl_t_pecas_ev_fim" bpmnElement="fl_t_pecas_ev_fim">
        <di:waypoint x="1960" y="520" />
        <di:waypoint x="1995" y="520" />
        <di:waypoint x="1995" y="315" />
        <di:waypoint x="2030" y="315" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

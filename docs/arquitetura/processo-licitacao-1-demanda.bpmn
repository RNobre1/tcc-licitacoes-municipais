<?xml version="1.0" encoding="UTF-8"?>
<!--
  Processo da fase preparatória de uma contratação, em BPMN 2.0.

  ESTE ARQUIVO É A FONTE a partir de agora. É XML padrão da OMG e abre em
  qualquer ferramenta da notação, inclusive na indicada pela orientação, para
  conferência e edição. A figura do texto é gerada dele por
  `scripts/gerar_bpmn.py`, e nunca o contrário.

  O desenho inicial saiu de `scripts/montar_bpmn.py`, que calcula as
  coordenadas de modo que nenhuma ligação cruze outra. Rodar aquele script de
  novo SOBRESCREVE este arquivo e descarta qualquer ajuste feito à mão.

  Recorte: contratação de material ou serviço comum, com valor estimado montado
  por pesquisa de preços. Obras ficam de fora, porque seu orçamento sai de
  planilha de custos sobre tabela de referência, que é outro mecanismo.

  As duas decisões exclusivas marcam etapas que podem não acontecer: a
  consolidação só existe quando mais de uma secretaria pede o mesmo item, e a
  pesquisa de preços é pulada quando o preço vem de ata ou contrato vigente.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="defs_licitacao"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="colaboracao">
    <bpmn:participant id="pool_prefeitura" name="Prefeitura — Da demanda à minuta do estudo técnico"
                      processRef="processo_licitacao" />
  </bpmn:collaboration>
  <bpmn:process id="processo_licitacao" isExecutable="false">
    <bpmn:laneSet id="raias">
      <bpmn:lane id="raia_secretaria" name="Secretaria demandante">
        <bpmn:flowNodeRef>ev_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_formalizar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_licitacoes" name="Setor de licitações">
        <bpmn:flowNodeRef>t_importar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_consolida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_alinhar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_sistema" name="Sistema de apoio">
        <bpmn:flowNodeRef>t_extrair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_consenso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_minuta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_segue</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ev_inicio" name="Necessidade identificada">
      <bpmn:outgoing>fl_ev_inicio_t_formalizar</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t_formalizar" name="Formalizar demanda">
      <bpmn:incoming>fl_ev_inicio_t_formalizar</bpmn:incoming>
      <bpmn:outgoing>fl_t_formalizar_t_importar</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_importar" name="Importar documentos de demanda">
      <bpmn:incoming>fl_t_formalizar_t_importar</bpmn:incoming>
      <bpmn:outgoing>fl_t_importar_t_extrair</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_extrair" name="Extrair itens, quantidades e unidades">
      <bpmn:incoming>fl_t_importar_t_extrair</bpmn:incoming>
      <bpmn:outgoing>fl_t_extrair_g_consolida</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_consolida" name="Item pedido por mais de uma secretaria?">
      <bpmn:incoming>fl_t_extrair_g_consolida</bpmn:incoming>
      <bpmn:outgoing>fl_g_consolida_t_consenso</bpmn:outgoing>
      <bpmn:outgoing>fl_g_consolida_t_minuta</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_consenso" name="Propor descrição de consenso">
      <bpmn:incoming>fl_g_consolida_t_consenso</bpmn:incoming>
      <bpmn:outgoing>fl_t_consenso_t_alinhar</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_alinhar" name="Alinhar descrição com as secretarias">
      <bpmn:incoming>fl_t_consenso_t_alinhar</bpmn:incoming>
      <bpmn:outgoing>fl_t_alinhar_t_minuta</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_minuta" name="Emitir minuta do estudo técnico">
      <bpmn:incoming>fl_t_alinhar_t_minuta</bpmn:incoming>
      <bpmn:incoming>fl_g_consolida_t_minuta</bpmn:incoming>
      <bpmn:outgoing>fl_t_minuta_ev_segue</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="ev_segue" name="Segue na parte 2">
      <bpmn:incoming>fl_t_minuta_ev_segue</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="fl_ev_inicio_t_formalizar" sourceRef="ev_inicio" targetRef="t_formalizar" />
    <bpmn:sequenceFlow id="fl_t_formalizar_t_importar" sourceRef="t_formalizar" targetRef="t_importar" />
    <bpmn:sequenceFlow id="fl_t_importar_t_extrair" sourceRef="t_importar" targetRef="t_extrair" />
    <bpmn:sequenceFlow id="fl_t_extrair_g_consolida" sourceRef="t_extrair" targetRef="g_consolida" />
    <bpmn:sequenceFlow id="fl_g_consolida_t_consenso" name="sim" sourceRef="g_consolida" targetRef="t_consenso" />
    <bpmn:sequenceFlow id="fl_t_consenso_t_alinhar" sourceRef="t_consenso" targetRef="t_alinhar" />
    <bpmn:sequenceFlow id="fl_t_alinhar_t_minuta" sourceRef="t_alinhar" targetRef="t_minuta" />
    <bpmn:sequenceFlow id="fl_g_consolida_t_minuta" name="não" sourceRef="g_consolida" targetRef="t_minuta" />
    <bpmn:sequenceFlow id="fl_t_minuta_ev_segue" sourceRef="t_minuta" targetRef="ev_segue" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagrama">
    <bpmndi:BPMNPlane id="plano" bpmnElement="colaboracao">
      <bpmndi:BPMNShape id="di_pool" bpmnElement="pool_prefeitura" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="1509" height="715" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_raia_secretaria" bpmnElement="raia_secretaria" isHorizontal="true">
        <dc:Bounds x="190" y="60" width="1479" height="215" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_raia_licitacoes" bpmnElement="raia_licitacoes" isHorizontal="true">
        <dc:Bounds x="190" y="275" width="1479" height="245" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_raia_sistema" bpmnElement="raia_sistema" isHorizontal="true">
        <dc:Bounds x="190" y="520" width="1479" height="255" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_ev_inicio" bpmnElement="ev_inicio">
        <dc:Bounds x="220" y="148" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_t_formalizar" bpmnElement="t_formalizar">
        <dc:Bounds x="378" y="130" width="125" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_t_importar" bpmnElement="t_importar">
        <dc:Bounds x="536" y="360" width="125" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_t_extrair" bpmnElement="t_extrair">
        <dc:Bounds x="694" y="610" width="125" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_g_consolida" bpmnElement="g_consolida">
        <dc:Bounds x="852" y="368" width="60" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_t_consenso" bpmnElement="t_consenso">
        <dc:Bounds x="1010" y="610" width="125" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_t_alinhar" bpmnElement="t_alinhar">
        <dc:Bounds x="1168" y="360" width="125" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_t_minuta" bpmnElement="t_minuta">
        <dc:Bounds x="1326" y="610" width="125" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_ev_segue" bpmnElement="ev_segue">
        <dc:Bounds x="1484" y="628" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="di_fl_ev_inicio_t_formalizar" bpmnElement="fl_ev_inicio_t_formalizar">
        <di:waypoint x="260" y="168" />
        <di:waypoint x="378" y="168" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_fl_t_formalizar_t_importar" bpmnElement="fl_t_formalizar_t_importar">
        <di:waypoint x="503" y="168" />
        <di:waypoint x="519" y="168" />
        <di:waypoint x="519" y="398" />
        <di:waypoint x="536" y="398" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_fl_t_importar_t_extrair" bpmnElement="fl_t_importar_t_extrair">
        <di:waypoint x="661" y="398" />
        <di:waypoint x="677" y="398" />
        <di:waypoint x="677" y="648" />
        <di:waypoint x="694" y="648" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_fl_t_extrair_g_consolida" bpmnElement="fl_t_extrair_g_consolida">
        <di:waypoint x="819" y="648" />
        <di:waypoint x="835" y="648" />
        <di:waypoint x="835" y="398" />
        <di:waypoint x="852" y="398" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_fl_g_consolida_t_consenso" bpmnElement="fl_g_consolida_t_consenso">
        <di:waypoint x="912" y="398" />
        <di:waypoint x="951" y="398" />
        <di:waypoint x="951" y="648" />
        <di:waypoint x="1010" y="648" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_fl_t_consenso_t_alinhar" bpmnElement="fl_t_consenso_t_alinhar">
        <di:waypoint x="1135" y="648" />
        <di:waypoint x="1151" y="648" />
        <di:waypoint x="1151" y="398" />
        <di:waypoint x="1168" y="398" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_fl_t_alinhar_t_minuta" bpmnElement="fl_t_alinhar_t_minuta">
        <di:waypoint x="1293" y="398" />
        <di:waypoint x="1309" y="398" />
        <di:waypoint x="1309" y="648" />
        <di:waypoint x="1326" y="648" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_fl_g_consolida_t_minuta" bpmnElement="fl_g_consolida_t_minuta">
        <di:waypoint x="912" y="398" />
        <di:waypoint x="950" y="398" />
        <di:waypoint x="950" y="757" />
        <di:waypoint x="1304" y="757" />
        <di:waypoint x="1304" y="648" />
        <di:waypoint x="1326" y="648" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_fl_t_minuta_ev_segue" bpmnElement="fl_t_minuta_ev_segue">
        <di:waypoint x="1451" y="648" />
        <di:waypoint x="1484" y="648" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

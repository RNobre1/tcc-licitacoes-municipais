  <diagram name="Modelo de dados" id="modelo-de-dados">
    <mxGraphModel dx="750" dy="930" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="750" pageHeight="930" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="md-titulo" value="&lt;b&gt;Modelo de dados&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px; color: #666666;&quot;&gt;Persistência relacional da ingestão e índice vetorial no Qdrant, ligados pela chave do PublicItem&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="20" y="15" width="710" height="48" as="geometry" />
        </mxCell>

        <!-- Fronteira PostgreSQL -->
        <mxCell id="md-pg-fronteira" value="PostgreSQL — banco relacional (ingestion)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#5B8DD6;strokeWidth=1.4;fontSize=12;fontColor=#2E6295;fontStyle=1;verticalAlign=bottom;align=left;spacingLeft=12;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="75" width="340" height="830" as="geometry" />
        </mxCell>

        <!-- Fronteira Qdrant -->
        <mxCell id="md-qd-fronteira" value="Qdrant — índice semântico (semantic_index)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#5B8DD6;strokeWidth=1.4;fontSize=12;fontColor=#2E6295;fontStyle=1;verticalAlign=bottom;align=left;spacingLeft=12;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="415" y="75" width="315" height="515" as="geometry" />
        </mxCell>

        <!-- Classe RawRecord -->
        <mxCell id="md-rawrecord" value="&lt;div style=&quot;background:#E8F0FE; border-bottom:1.5px solid #2E6295; padding:7px; text-align:center;&quot;&gt;&lt;span style=&quot;font-size:10px; color:#2E6295;&quot;&gt;«model»&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;&quot;&gt;RawRecord&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding:7px 10px; border-bottom:1px solid #B8CCE4; font-size:11px; line-height:1.45;&quot;&gt;+ &lt;b&gt;id&lt;/b&gt;: BigAutoField «PK»&lt;br&gt;+ endpoint: TextField&lt;br&gt;+ params: JSONField (JSON)&lt;br&gt;+ fetched_at: DateTimeField&lt;br&gt;+ payload: JSONField (JSONB)&lt;br&gt;+ status_code: PositiveIntegerField?&lt;/div&gt;&lt;div style=&quot;padding:6px 10px; font-size:11px; line-height:1.35;&quot;&gt;+ __str__(): str&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E6295;strokeWidth=1.5;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="300" height="190" as="geometry" />
        </mxCell>

        <!-- Classe PublicItem -->
        <mxCell id="md-publicitem" value="&lt;div style=&quot;background:#E8F0FE; border-bottom:1.5px solid #2E6295; padding:7px; text-align:center;&quot;&gt;&lt;span style=&quot;font-size:10px; color:#2E6295;&quot;&gt;«model»&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;&quot;&gt;PublicItem&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding:7px 10px; border-bottom:1px solid #B8CCE4; font-size:11px; line-height:1.36;&quot;&gt;+ &lt;b&gt;id&lt;/b&gt;: BigAutoField «PK»&lt;br&gt;&lt;span style=&quot;color:#666666; font-size:10px;&quot;&gt;— chave do PNCP (UniqueConstraint) —&lt;/span&gt;&lt;br&gt;+ cnpj: CharField(14)&lt;br&gt;+ year: PositiveIntegerField&lt;br&gt;+ purchase_sequence: PositiveIntegerField&lt;br&gt;+ item_number: PositiveIntegerField&lt;br&gt;&lt;span style=&quot;color:#666666; font-size:10px;&quot;&gt;— descrição e unidade —&lt;/span&gt;&lt;br&gt;+ description: TextField&lt;br&gt;+ unit: CharField(50)&lt;br&gt;+ unit_normalized: CharField(50)&lt;br&gt;+ quantity: DecimalField(24, 4)&lt;br&gt;&lt;span style=&quot;color:#666666; font-size:10px;&quot;&gt;— preços e resultado —&lt;/span&gt;&lt;br&gt;+ estimated_unit_price: DecimalField(24, 4)&lt;br&gt;+ awarded_unit_price: DecimalField(24, 4)?&lt;br&gt;+ has_result: BooleanField&lt;br&gt;+ secret_budget: BooleanField&lt;br&gt;&lt;span style=&quot;color:#666666; font-size:10px;&quot;&gt;— órgão, publicação e filtro —&lt;/span&gt;&lt;br&gt;+ published_on: DateField&lt;br&gt;+ agency_name: TextField&lt;br&gt;+ agency_cnpj: CharField(14)&lt;br&gt;+ state: CharField(2)&lt;br&gt;+ modality: PositiveIntegerField&lt;br&gt;+ item_kind: CharField(10)&lt;br&gt;+ created_at: DateTimeField&lt;br&gt;+ updated_at: DateTimeField&lt;/div&gt;&lt;div style=&quot;padding:6px 10px; font-size:11px; line-height:1.36;&quot;&gt;+ pncp_key(): (cnpj, year, seq, item)&lt;br&gt;+ usable_estimated_unit_price(): Decimal?&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E6295;strokeWidth=1.5;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="345" width="300" height="510" as="geometry" />
        </mxCell>

        <!-- Associação N:N RawRecord <-> PublicItem -->
        <mxCell id="md-nn" value="raw_records — procedência (N:N)" style="edgeStyle=none;rounded=0;html=1;fontSize=11;fontColor=#222222;strokeColor=#2E6295;strokeWidth=1.5;endArrow=none;startArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="md-rawrecord" target="md-publicitem">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="md-nn-mult-a" value="*" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#2E6295;" vertex="1" parent="1">
          <mxGeometry x="196" y="286" width="16" height="18" as="geometry" />
        </mxCell>
        <mxCell id="md-nn-mult-b" value="*" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#2E6295;" vertex="1" parent="1">
          <mxGeometry x="196" y="325" width="16" height="18" as="geometry" />
        </mxCell>

        <!-- Classe Collection (Qdrant) -->
        <mxCell id="md-collection" value="&lt;div style=&quot;background:#E8F0FE; border-bottom:1.5px solid #2E6295; padding:7px; text-align:center;&quot;&gt;&lt;span style=&quot;font-size:10px; color:#2E6295;&quot;&gt;«Qdrant collection»&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;&quot;&gt;Collection&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding:7px 10px; border-bottom:1px solid #B8CCE4; font-size:11px; line-height:1.45;&quot;&gt;+ name: str (&lt;i&gt;items_&amp;lt;modelo&amp;gt;_&amp;lt;revisão&amp;gt;&lt;/i&gt;)&lt;br&gt;+ vector_size: int&lt;br&gt;+ distance: Distance (COSINE)&lt;br&gt;+ payload_schema: índices de filtro&lt;/div&gt;&lt;div style=&quot;padding:6px 10px; font-size:10.5px; color:#555555;&quot;&gt;Modelo e revisão são codificados no nome&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E6295;strokeWidth=1.5;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="435" y="95" width="275" height="165" as="geometry" />
        </mxCell>

        <!-- Classe Point (Qdrant) -->
        <mxCell id="md-point" value="&lt;div style=&quot;background:#E8F0FE; border-bottom:1.5px solid #2E6295; padding:7px; text-align:center;&quot;&gt;&lt;span style=&quot;font-size:10px; color:#2E6295;&quot;&gt;«Qdrant point»&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;&quot;&gt;Point (PointStruct)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding:7px 10px; font-size:11px; line-height:1.45;&quot;&gt;+ &lt;b&gt;id&lt;/b&gt;: int (&lt;i&gt;= PublicItem.id&lt;/i&gt;)&lt;br&gt;+ vector: float[vector_size]&lt;br&gt;+ payload: dict&lt;br&gt;&amp;nbsp;&amp;nbsp;• unit: str (&lt;i&gt;unit_normalized&lt;/i&gt;)&lt;br&gt;&amp;nbsp;&amp;nbsp;• state: str&lt;br&gt;&amp;nbsp;&amp;nbsp;• published_on: date&lt;br&gt;&amp;nbsp;&amp;nbsp;• item_kind: str&lt;br&gt;&amp;nbsp;&amp;nbsp;• modality: int&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E6295;strokeWidth=1.5;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="435" y="330" width="275" height="215" as="geometry" />
        </mxCell>

        <!-- Composição Collection 1 -> * Point -->
        <mxCell id="md-comp" value="armazena" style="edgeStyle=none;rounded=0;html=1;fontSize=11;fontColor=#222222;strokeColor=#2E6295;strokeWidth=1.5;startArrow=diamondThin;startFill=1;startSize=12;endArrow=open;endFill=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="md-collection" target="md-point">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="md-comp-mult-1" value="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#2E6295;" vertex="1" parent="1">
          <mxGeometry x="578" y="262" width="16" height="18" as="geometry" />
        </mxCell>
        <mxCell id="md-comp-mult-n" value="*" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#2E6295;" vertex="1" parent="1">
          <mxGeometry x="578" y="310" width="16" height="18" as="geometry" />
        </mxCell>

        <!-- Ponte Point.id = PublicItem.id -->
        <mxCell id="md-ponte" value="point.id =&lt;br&gt;PublicItem.id" style="edgeStyle=none;rounded=0;html=1;fontSize=11;fontStyle=1;fontColor=#B45309;strokeColor=#D97706;strokeWidth=2;dashed=1;dashPattern=6 4;endArrow=open;endFill=0;exitX=0;exitY=0.5;entryX=1;entryY=0.1814;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="md-point" target="md-publicitem">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Notas explicativas -->
        <mxCell id="md-nota-prov" value="&lt;b&gt;Procedência até a origem (RN08)&lt;/b&gt;&lt;div style=&quot;margin-top:5px; line-height:1.4;&quot;&gt;A relação N:N (&lt;code&gt;raw_records&lt;/code&gt;) liga cada &lt;code&gt;PublicItem&lt;/code&gt; aos registros brutos de publicação, itens e resultado que o originaram.&lt;br&gt;&lt;br&gt;&lt;code&gt;build_public_items&lt;/code&gt; lê apenas a cópia mais recente de cada &lt;code&gt;(endpoint, params)&lt;/code&gt;.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0C46C;fontSize=11;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="415" y="605" width="315" height="125" as="geometry" />
        </mxCell>

        <mxCell id="md-nota-ponte" value="&lt;b&gt;Ponte entre os dois bancos&lt;/b&gt;&lt;div style=&quot;margin-top:5px; line-height:1.4;&quot;&gt;Não há chave estrangeira entre PostgreSQL e Qdrant: o ponto grava &lt;code&gt;id = PublicItem.id&lt;/code&gt;.&lt;br&gt;&lt;br&gt;Na busca, &lt;code&gt;semantic_search&lt;/code&gt; filtra no payload do Qdrant e hidrata os &lt;code&gt;PublicItem&lt;/code&gt; no PostgreSQL.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0C46C;fontSize=11;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="415" y="740" width="315" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

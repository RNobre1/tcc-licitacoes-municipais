        <mxCell id="g13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#707070;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s9" target="s10"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="nota3a" value="&lt;b&gt;O recorte deste trabalho:&lt;/b&gt;&amp;nbsp; material de consumo, material permanente e servi&#231;o comum, ou seja, o que tem o valor estimado montado por pesquisa de pre&#231;os. &lt;b&gt;Obras e servi&#231;os de engenharia ficam de fora&lt;/b&gt;, porque o or&#231;amento deles sai de planilha de custos sobre tabela de refer&#234;ncia, que &#233; outro mecanismo inteiro." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#C4C4C4;fontSize=11;align=left;verticalAlign=middle;spacing=10;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="80" y="610" width="930" height="60" as="geometry" />
        </mxCell>

        <mxCell id="nota3b" value="&lt;b&gt;Por que mirar o caminho longo, se ele n&#227;o &#233; o mais frequente.&lt;/b&gt;&amp;nbsp; Por contagem, a maior parte dos processos do setor &#233; de outro tipo: dispensa, inexigibilidade, ades&#227;o a ata. Mas por tempo consumido a rela&#231;&#227;o se inverte: uma cota&#231;&#227;o consolidada de 150 itens levou 28 dias corridos, e uma ades&#227;o a ata n&#227;o tem cota&#231;&#227;o nenhuma. &lt;b&gt;A propor&#231;&#227;o entre os tipos ainda n&#227;o foi medida&lt;/b&gt;, e est&#225; na lista do que perguntar." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0C46C;fontSize=11;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="690" width="930" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ancora" value="&lt;b&gt;Pre&#231;o esperado&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;informado pelo operador&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;fillColor=#E3F2E1;strokeColor=#6BA96F;fontSize=11;fontColor=#33513A;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="150" height="62" as="geometry" />
        </mxCell>

        <mxCell id="g14" value="ancora o ranqueamento" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#6BA96F;strokeWidth=1.5;fontSize=10;fontColor=#33513A;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.306;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=left;" edge="1" parent="1" source="ancora" target="s6">

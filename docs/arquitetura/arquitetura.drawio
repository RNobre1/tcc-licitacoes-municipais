        <mxCell id="sq2-m14" value="9. painel: média, mediana e menor valor (IN 65/2021, art. 6º) só com homologados" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontColor=#222222;strokeColor=#444444;strokeWidth=1.3;endArrow=blockThin;endFill=1;exitX=1;exitY=0.7545;entryX=1;entryY=0.7909;align=left;labelPosition=right;verticalAlign=middle;spacingLeft=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sq2-act-visao" target="sq2-act-visao">

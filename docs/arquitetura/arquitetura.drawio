        <mxCell id="g12" value="sim, o valor j&#225; existe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#3C3C3C;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d2" target="s9">

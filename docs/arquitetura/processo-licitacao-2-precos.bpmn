<?xml version="1.0" encoding="UTF-8"?>
<!--
  Processo da fase preparatória de uma contratação, em BPMN 2.0.

  ESTE ARQUIVO É A FONTE a partir de agora. É XML padrão da OMG e abre em
  qualquer ferramenta da notação, inclusive na indicada pela orientação, para
  conferência e edição. A figura do texto é gerada dele por
  `scripts/gerar_bpmn.py`, e nunca o contrário.

  O desenho inicial saiu de `scripts/montar_bpmn.py`, que calcula as
  coordenadas de modo que nenhuma ligação cruze outra. Rodar aquele script de
  novo SOBRESCREVE este arquivo e descarta qualquer ajuste feito à mão.

  Recorte: contratação de material ou serviço comum, com valor estimado montado
  por pesquisa de preços. Obras ficam de fora, porque seu orçamento sai de
  planilha de custos sobre tabela de referência, que é outro mecanismo.

  As duas decisões exclusivas marcam etapas que podem não acontecer: a
  consolidação só existe quando mais de uma secretaria pede o mesmo item, e a
  pesquisa de preços é pulada quando o preço vem de ata ou contrato vigente.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="defs_licitacao"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="colaboracao">
    <bpmn:participant id="pool_prefeitura" name="Prefeitura — Da pesquisa de preços às peças do processo"
                      processRef="processo_licitacao" />
  </bpmn:collaboration>
  <bpmn:process id="processo_licitacao" isExecutable="false">
    <bpmn:laneSet id="raias">
      <bpmn:lane id="raia_secretaria" name="Secretaria demandante">

      </bpmn:lane>
      <bpmn:lane id="raia_licitacoes" name="Setor de licitações">
        <bpmn:flowNodeRef>g_ata</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_triar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_fim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="raia_sistema" name="Sistema de apoio">
        <bpmn:flowNodeRef>ev_vem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_recuperar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_calcular</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pecas</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ev_vem" name="Minuta emitida">
      <bpmn:outgoing>fl_ev_vem_g_ata</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="g_ata" name="Preço vem de ata ou contrato vigente?">
      <bpmn:incoming>fl_ev_vem_g_ata</bpmn:incoming>
      <bpmn:outgoing>fl_g_ata_t_recuperar</bpmn:outgoing>
      <bpmn:outgoing>fl_g_ata_t_pecas</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_recuperar" name="Recuperar candidatos por significado">
      <bpmn:incoming>fl_g_ata_t_recuperar</bpmn:incoming>
      <bpmn:outgoing>fl_t_recuperar_t_triar</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_triar" name="Triar candidatos e decidir">
      <bpmn:incoming>fl_t_recuperar_t_triar</bpmn:incoming>
      <bpmn:outgoing>fl_t_triar_t_calcular</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_calcular" name="Calcular valor e gerar mapa de cotação">
      <bpmn:incoming>fl_t_triar_t_calcular</bpmn:incoming>
      <bpmn:outgoing>fl_t_calcular_t_pecas</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_pecas" name="Gerar estudo final e termo de referência">
      <bpmn:incoming>fl_t_calcular_t_pecas</bpmn:incoming>
      <bpmn:incoming>fl_g_ata_t_pecas</bpmn:incoming>
      <bpmn:outgoing>fl_t_pecas_t_revisar</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_revisar" name="Revisar e assinar as peças">
      <bpmn:incoming>fl_t_pecas_t_revisar</bpmn:incoming>
      <bpmn:outgoing>fl_t_revisar_ev_fim</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="ev_fim" name="Processo instruído">
      <bpmn:incoming>fl_t_revisar_ev_fim</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="fl_ev_vem_g_ata" sourceRef="ev_vem" targetRef="g_ata" />
    <bpmn:sequenceFlow id="fl_g_ata_t_recuperar" name="não" sourceRef="g_ata" targetRef="t_recuperar" />
    <bpmn:sequenceFlow id="fl_t_recuperar_t_triar" sourceRef="t_recuperar" targetRef="t_triar" />
    <bpmn:sequenceFlow id="fl_t_triar_t_calcular" sourceRef="t_triar" targetRef="t_calcular" />
    <bpmn:sequenceFlow id="fl_t_calcular_t_pecas" sourceRef="t_calcular" targetRef="t_pecas" />
    <bpmn:sequenceFlow id="fl_g_ata_t_pecas" name="sim" sourceRef="g_ata" targetRef="t_pecas" />
    <bpmn:sequenceFlow id="fl_t_pecas_t_revisar" sourceRef="t_pecas" targetRef="t_revisar" />
    <bpmn:sequenceFlow id="fl_t_revisar_ev_fim" sourceRef="t_revisar" targetRef="ev_fim" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagrama">
    <bpmndi:BPMNPlane id="plano" bpmnElement="colaboracao">
      <bpmndi:BPMNShape id="di_pool" bpmnElement="pool_prefeitura" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="1351" height="715" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_raia_secretaria" bpmnElement="raia_secretaria" isHorizontal="true">
        <dc:Bounds x="190" y="60" width="1321" height="215" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_raia_licitacoes" bpmnElement="raia_licitacoes" isHorizontal="true">
        <dc:Bounds x="190" y="275" width="1321" height="245" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_raia_sistema" bpmnElement="raia_sistema" isHorizontal="true">
        <dc:Bounds x="190" y="520" width="1321" height="255" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_ev_vem" bpmnElement="ev_vem">
        <dc:Bounds x="220" y="628" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_g_ata" bpmnElement="g_ata">
        <dc:Bounds x="378" y="368" width="60" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_t_recuperar" bpmnElement="t_recuperar">
        <dc:Bounds x="536" y="610" width="125" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_t_triar" bpmnElement="t_triar">
        <dc:Bounds x="694" y="360" width="125" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_t_calcular" bpmnElement="t_calcular">
        <dc:Bounds x="852" y="610" width="125" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_t_pecas" bpmnElement="t_pecas">
        <dc:Bounds x="1010" y="610" width="125" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_t_revisar" bpmnElement="t_revisar">
        <dc:Bounds x="1168" y="360" width="125" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_ev_fim" bpmnElement="ev_fim">
        <dc:Bounds x="1326" y="378" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="di_fl_ev_vem_g_ata" bpmnElement="fl_ev_vem_g_ata">
        <di:waypoint x="260" y="648" />
        <di:waypoint x="307" y="648" />
        <di:waypoint x="307" y="398" />
        <di:waypoint x="378" y="398" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_fl_g_ata_t_recuperar" bpmnElement="fl_g_ata_t_recuperar">
        <di:waypoint x="438" y="398" />
        <di:waypoint x="477" y="398" />
        <di:waypoint x="477" y="648" />
        <di:waypoint x="536" y="648" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_fl_t_recuperar_t_triar" bpmnElement="fl_t_recuperar_t_triar">
        <di:waypoint x="661" y="648" />
        <di:waypoint x="677" y="648" />
        <di:waypoint x="677" y="398" />
        <di:waypoint x="694" y="398" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_fl_t_triar_t_calcular" bpmnElement="fl_t_triar_t_calcular">
        <di:waypoint x="819" y="398" />
        <di:waypoint x="835" y="398" />
        <di:waypoint x="835" y="648" />
        <di:waypoint x="852" y="648" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_fl_t_calcular_t_pecas" bpmnElement="fl_t_calcular_t_pecas">
        <di:waypoint x="977" y="648" />
        <di:waypoint x="1010" y="648" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_fl_g_ata_t_pecas" bpmnElement="fl_g_ata_t_pecas">
        <di:waypoint x="438" y="398" />
        <di:waypoint x="476" y="398" />
        <di:waypoint x="476" y="757" />
        <di:waypoint x="988" y="757" />
        <di:waypoint x="988" y="648" />
        <di:waypoint x="1010" y="648" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_fl_t_pecas_t_revisar" bpmnElement="fl_t_pecas_t_revisar">
        <di:waypoint x="1135" y="648" />
        <di:waypoint x="1151" y="648" />
        <di:waypoint x="1151" y="398" />
        <di:waypoint x="1168" y="398" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_fl_t_revisar_ev_fim" bpmnElement="fl_t_revisar_ev_fim">
        <di:waypoint x="1293" y="398" />
        <di:waypoint x="1326" y="398" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

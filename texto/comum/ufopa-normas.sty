% 2.2 Margens — Margens esquerda e superior de 3 cm.
\newlength{\ufopamargemsuperior}
\setlength{\ufopamargemsuperior}{3cm}
% 2.2 Margens — Margens direita e inferior de 2 cm.
\newlength{\ufopamargemdireita}
\setlength{\ufopamargemdireita}{2cm}
% 2.2 Margens — Margens direita e inferior de 2 cm.
\newlength{\ufopamargeminferior}
\setlength{\ufopamargeminferior}{2cm}
% 2.2 Margens — 'Para o recuo da primeira linha do parágrafo, recomenda-se um recuo de 2 cm.' Difere do padrão abnTeX2 (1,5 cm) — não herdar o default.
\newlength{\ufoparecuoparagrafo}
\setlength{\ufoparecuoparagrafo}{2cm}
% 2.2 Margens — Citação com mais de três linhas: recuo de 4 cm da margem esquerda, justificada, sem aspas, com 1,5 cm de espaço antes e depois.
\newlength{\ufoparecuocitacao}
\setlength{\ufoparecuocitacao}{4cm}
% 2.6 Paginação — Número de página no canto superior direito, a 2 cm da borda superior e o último algarismo a 2 cm da borda direita.
\newlength{\ufopadistpaginacao}
\setlength{\ufopadistpaginacao}{2cm}


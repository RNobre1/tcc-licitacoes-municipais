# Alvos compartilhados por texto/tcc1 e texto/tcc2.
# FONTE ÚNICA: não duplique receitas nos Makefiles dos documentos.
#
# Cada documento tem TRÊS alvos de layout sobre o MESMO conteúdo:
#
#   main-curso.tex → modelo cedido pela orientação em 07/10/2026. É o que o curso
#                    recebe, e o formato que a banca reconhece.
#   main-sbc.tex   → padrão da SBC, adotado em 24/08/2026 quando o modelo do
#                    curso estava inacessível. É o que um congresso aceita sem
#                    retrabalho, e por isso continua valendo.
#   main.tex       → formato tradicional, guia do SIBI/Ufopa. É o que a biblioteca
#                    exige no depósito, com capa, folha de rosto e agradecimento.
#
# O conteúdo vive uma vez só, em secoes/ ou capitulos/. Cada alvo é um arquivo
# fino que escolhe estilo e ordem — nunca copia texto.
#
# O alvo do curso só existe onde main-curso.tex existir: `pdf` o pula em silêncio
# nos documentos que ainda não o têm, em vez de falhar.
#
# Os caminhos de busca do TeX não estão aqui: vivem em ../comum/latexmkrc-comum,
# carregado pelo .latexmkrc de cada documento. Assim `make` e `latexmk` avulso —
# inclusive o que os testes invocam — resolvem os mesmos caminhos.

LATEXMK := latexmk -pdf -interaction=nonstopmode -halt-on-error

.PHONY: help pdf pdf-curso pdf-sbc pdf-sibi watch watch-sibi clean distclean

help:  ## Lista os alvos
	@grep -hE '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | \
		awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-12s\033[0m %s\n", $$1, $$2}'

pdf: pdf-curso pdf-sbc pdf-sibi  ## Compila os três layouts (é o entregável real)

pdf-curso:  ## Compila o alvo do modelo do curso, se este documento o tiver
	@test -f main-curso.tex && $(LATEXMK) main-curso.tex || \
		echo "  (sem main-curso.tex neste documento — pulado)"

pdf-sbc:  ## Compila só o alvo principal, no formato de artigo da SBC
	$(LATEXMK) main-sbc.tex

pdf-sibi:  ## Compila só o alvo do depósito na biblioteca, no formato do SIBI
	$(LATEXMK) main.tex

watch:  ## Recompila o alvo da SBC a cada gravação
	latexmk -pdf -pvc -interaction=nonstopmode main-sbc.tex

watch-sibi:  ## Recompila o alvo do SIBI a cada gravação
	latexmk -pdf -pvc -interaction=nonstopmode main.tex

clean:  ## Remove artefatos intermediários de todos os alvos, preserva os PDFs
	latexmk -c main-sbc.tex main.tex $(wildcard main-curso.tex)
	rm -f *.bbl *.blg *.run.xml

distclean:  ## Remove tudo, inclusive os PDFs
	latexmk -C main-sbc.tex main.tex $(wildcard main-curso.tex)
	rm -f *.bbl *.blg *.run.xml
